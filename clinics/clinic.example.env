# One file per clinic: copy to clinics/<slug>.env (gitignored) and fill in. Then run:
#   pnpm clinic:setup clinics/<slug>.env --dry-run     (check the file, print the plan)
#   pnpm clinic:setup clinics/<slug>.env               (do it; safe to re-run)
# Never commit a filled-in file. It holds secrets.

# --- The clinic ---
CLINIC_NAME=Smile Dental Clinic
CLINIC_SLUG=smile-dental                 # lowercase, dashes; used in /join/<slug>
CLINIC_EMAIL=reception@clinic.co.uk      # reception inbox: copied on bookings, gets alerts
CLINIC_PHONE=
CLINIC_ADDRESS=
MANAGER_EMAIL=manager@clinic.co.uk       # invited as OWNER
APP_URL=https://recovery.clinic.co.uk    # the clinic's own app address, no trailing path

# --- Supabase (one project per clinic, London) ---
SUPABASE_PROJECT_REF=                    # 20 letters, the id in the project URL
SUPABASE_ACCESS_TOKEN=                   # sbp_... (Supabase -> Account -> Access Tokens)

# --- Email: the clinic's own Brevo SMTP ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=appointments@clinic.co.uk
SMTP_FROM_NAME=Smile Dental Clinic

# --- Vercel (leave blank to get a .vercel.env file to paste instead) ---
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- Dentally (READ-ONLY token created by the clinic's Dentally admin) ---
DENTALLY_API_BASE_URL=
DENTALLY_API_TOKEN=
DENTALLY_WEBHOOK_SECRET=                 # leave blank: generated and saved here

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=            # or TWILIO_SMS_FROM=+44...
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# --- Slack (front-desk approval; front-desk-only channel) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# --- Engine / ops ---
CRON_SECRET=                             # leave blank: generated and saved here
OPERATOR_ALERT_EMAIL=you@yourdomain.com
SHADOW_TEST_PHONE=+447000000000
SHADOW_TEST_EMAIL=you@yourdomain.com
EXTERNAL_API_KEY=
